{
  "name": "korea-history-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "fetch:heritage": "tsx scripts/fetch-heritage.ts",
    "fetch:curated": "tsx scripts/fetch-curated-heritage.ts",
    "enrich:photos": "tsx scripts/enrich-photos.ts",
    "enrich:photos:nearby": "tsx scripts/enrich-photos.ts openapi-nearby",
    "enrich:photos:all": "tsx scripts/enrich-photos.ts openapi-all",
    "enrich:photos:khs": "tsx scripts/enrich-photos-khs.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.2",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.16",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "proj4": "^2.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
